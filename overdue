#!/bin/bash
# overdue: move the due: date of every open task that is past due to today.
# Tasks without a due: date, completed (x) tasks and recurring (rec:) tasks are
# left untouched; recurrence uses the original due: date to compute the next one.

action=$1
shift

[ "$action" = "usage" ] && {
  echo "  overdue"
  echo "    Move the due: date of all open, past-due tasks to today."
  echo "    Recurring tasks (rec:) keep their original due: date."
  echo ""
  exit
}

today=$(date +%Y-%m-%d)
tmp=$(mktemp) || exit 1

awk -v today="$today" '
  !/^x / && !/(^|[ \t])rec:[^ \t]/ && match($0, /due:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) {
    d = substr($0, RSTART + 4, 10)
    if (d < today) {
      $0 = substr($0, 1, RSTART + 3) today substr($0, RSTART + RLENGTH)
      printf "%d %s\n", NR, $0 > "/dev/stderr"
      n++
    }
  }
  { print }
  END { printf "TODO: %d task(s) moved to due:%s\n", n, today > "/dev/stderr" }
' "$TODO_FILE" > "$tmp" && cat "$tmp" > "$TODO_FILE"
rm -f "$tmp"
